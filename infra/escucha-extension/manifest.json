{
  "manifest_version": 3,
  "name": "Tronador Monitor",
  "version": "0.2.0",
  "description": "Colector de escenario social dirigido por el tablero: navega las cuentas del plan (IG/X/FB/TikTok) con disciplina anti-bloqueo y aporta lo relevado al historial del proyecto.",
  "permissions": ["storage", "alarms", "notifications", "scripting", "tabs", "sidePanel"],
  "host_permissions": [
    "https://*.facebook.com/*",
    "https://*.instagram.com/*",
    "https://x.com/*",
    "https://twitter.com/*",
    "https://*.tiktok.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": { "service_worker": "sw.js", "type": "module" },
  "options_page": "options.html",
  "action": {
    "default_title": "Tronador Monitor",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "side_panel": { "default_path": "panel.html" },
  "content_scripts": [
    {
      "matches": [
        "https://*.facebook.com/*",
        "https://*.instagram.com/*",
        "https://x.com/*",
        "https://twitter.com/*",
        "https://*.tiktok.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
